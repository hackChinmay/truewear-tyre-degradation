# ============================================================
# TrueWear - Environment Configuration Template
# ============================================================
# Copy this file to .env and replace the placeholder values.
# NEVER commit your actual .env file or private credentials.
# ============================================================

# ------------------------------------------------------------
# Gemini AI
# ------------------------------------------------------------
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"


# ------------------------------------------------------------
# Application & Telemetry API
# ------------------------------------------------------------
APP_URL="YOUR_APP_URL"
# Centralized FastAPI backend base URL (production deployed on Render)
# Local development fallback is http://localhost:8000
VITE_API_BASE_URL="https://truewear-api.onrender.com"


# ------------------------------------------------------------
# Firebase - Client Configuration
# ------------------------------------------------------------
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_MEASUREMENT_ID="YOUR_FIREBASE_MEASUREMENT_ID"


# ------------------------------------------------------------
# Firebase - Backend Configuration
# ------------------------------------------------------------
FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"

# Path to your Firebase service-account JSON.
# NEVER commit the service-account JSON file to GitHub.
GOOGLE_APPLICATION_CREDENTIALS="/path/to/serviceAccountKey.json"


# ------------------------------------------------------------
# Data & Telemetry Paths
# ------------------------------------------------------------
DATA_RAW_DIR="data/raw"
DATA_PROCESSED_DIR="data/processed"
DATA_FEATURES_DIR="data/features"
FASTF1_CACHE_DIR="data/raw/f1_cache"
MODELS_DIR="models"


# ------------------------------------------------------------
# Feature / Model Versioning
# ------------------------------------------------------------
FEATURE_VERSION="v1"
DATA_VERSION="v1"